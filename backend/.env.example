# Copy this file to .env and replace placeholder values with real ones.
# Never commit the real .env file — it contains secrets.

# JWT (HS256, minimum 32 characters for secrets)
JWT_ACCESS_SECRET=your-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Stripe (test mode keys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_KEY=whsec_your_stripe_webhook_secret

# Email (Gmail SMTP example; use MailHog for local dev: localhost:1025)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Kafka
KAFKA_HOST=localhost
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Service URLs (use service names when running inside Docker)
AUTH_SERVICE_URL=http://localhost:8081
EVENT_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085

# Auth DB
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5434
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_password

# Event DB
EVENT_DB_HOST=localhost
EVENT_DB_PORT=5435
EVENT_DB_NAME=event_db
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=event_password

# Booking DB
BOOKING_DB_HOST=localhost
BOOKING_DB_PORT=5436
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_user
BOOKING_DB_PASSWORD=booking_password

# Payment DB
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5437
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_password

# Notification DB
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5438
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_password

# Frontend
FRONTEND_URL=http://localhost:5173
